{
  "schemaVersion": 2,
  "services": [
    {
      "name": "lm-studio",
      "image": "ghcr.io/alxhslm/lms-headless:latest",
      "isMain": true,
      "internalPort": 1234,
      "volumes": [
        {
          "hostPath": "${RUNTIPI_APP_DATA_PATH}/media/lm-studio/models",
          "containerPath": "/root/.lmstudio/models"
        },
        {
          "hostPath": "${APP_DATA_DIR}/credentials",
          "containerPath": "/root/.lmstudio/credentials"
        },
        {
          "hostPath": "${APP_DATA_DIR}/settings.json",
          "containerPath": "/root/.lmstudio/settings.json"
        }
      ],
      "environment": [
        { "key": "LINK_DEVICE_NAME", "value": "${LINK_DEVICE_NAME}" },
        { "key": "MODEL_ID", "value": "${MODEL_ID}" },
        { "key": "CONTEXT_LENGTH", "value": "${CONTEXT_LENGTH}" },
        { "key": "PORT", "value": "${PORT}" },
        { "key": "CUDA_VISIBLE_DEVICES", "value": "${CUDA_VISIBLE_DEVICES}" }
      ]
    }
  ]
}
