{
  "schemaVersion": 2,
  "services": [
    {
      "name": "lm-studio",
      "image": "lscr.io/linuxserver/lm-studio:latest",
      "isMain": true,
      "internalPort": 1234,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/models",
          "containerPath": "/root/.cache/lm-studio"
        }
      ],
      "environment": [
        { "key": "CUDA_VISIBLE_DEVICES", "value": "${CUDA_VISIBLE_DEVICES}" }
      ]
    }
  ]
}
