{
  "name": "LM Studio Headless",
  "id": "lm-studio",
  "available": true,
  "port": 1234,
  "short_desc": "Local AI model server and OpenAI-compatible API engine",
  "author": "LM Studio",
  "categories": ["utilities", "network"],
  "description": "LM Studio Headless (lms) runs a pure OpenAI-compatible local AI inference server for running GGUF LLMs on host CPU/GPU.",
  "tipi_version": 2,
  "version": "latest",
  "updated_at": 1784803700000,
  "source": "https://lmstudio.ai/docs/developer/core/headless",
  "exposable": false,
  "supported_architectures": ["arm64", "amd64"],
  "form_fields": [
    {
      "env_variable": "MODEL_ID",
      "type": "text",
      "label": "Model ID to load (e.g. google/gemma-4-e4b, google/gemma-4-e2b, gemma-2-9b-it)",
      "default": "google/gemma-4-e4b"
    },
    {
      "env_variable": "CONTEXT_LENGTH",
      "type": "number",
      "label": "Context Window Length in Tokens (e.g. 4096, 8192, 16384, 65536, 98304)",
      "default": 65536
    },
    {
      "env_variable": "PORT",
      "type": "number",
      "label": "LM Studio API Port",
      "default": 1234
    },
    {
      "env_variable": "CUDA_VISIBLE_DEVICES",
      "type": "text",
      "label": "GPU Device IDs (optional, e.g. 0,1 or all)",
      "default": "all"
    }
  ]
}
