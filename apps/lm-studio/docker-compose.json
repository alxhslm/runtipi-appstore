{
  "schemaVersion": 2,
  "services": [
    {
      "name": "lm-studio",
      "image": "lms-headless:latest",
      "pull_policy": "never",
      "isMain": true,
      "internalPort": 1234,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/models",
          "containerPath": "/root/.lmstudio/models"
        },
        {
          "hostPath": "${APP_DATA_DIR}/config",
          "containerPath": "/root/.config/lm-studio"
        },
        {
          "hostPath": "${APP_DATA_DIR}/auth",
          "containerPath": "/root/.lmstudio/user_data"
        }
      ],
      "environment": [
        { "key": "MODEL_ID", "value": "${MODEL_ID}" },
        { "key": "CONTEXT_LENGTH", "value": "${CONTEXT_LENGTH}" },
        { "key": "PORT", "value": "${PORT}" },
        { "key": "CUDA_VISIBLE_DEVICES", "value": "${CUDA_VISIBLE_DEVICES}" }
      ]
    }
  ]
}
